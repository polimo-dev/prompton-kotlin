        {
          "content": "You are a friendly greeter. Answer in one short line.",
          "role": "system"
        },
        {
          "content": "Say hello to {{ name }}.",
          "role": "user"
        }
      ],
      "text_template": null
    }
  },
  "models": {
    "openrouter:openai/gpt-4o-mini": {
      "provider": "openrouter",
      "model": "openai/gpt-4o-mini",
