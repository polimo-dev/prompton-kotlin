      "revision": "v2026.10.14-1",
      "provider": "openrouter",
      "model": "openai/gpt-4o-mini",
      "prompt_version": 1,
      "params": {
        "temperature": 0.2
      },
      "provider_options": {
        "only": [
          "OpenAI"
        ]
      },
      "api": "chat_completions",
      "request_path": "/api/v1/chat/completions"
    }
  },
  "prompt_versions": {
    "greeting@1": {
      "prompt": "greeting",
      "number": 1,
      "kind": "chat",
