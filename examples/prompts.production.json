{
  "schema_version": 1,
  "project": "sdkfixture",
  "environment": "production",
  "prompts": {
    "greeting": {
      "kind": "chat",
      "default_params": {
        "max_tokens": 256
      },
      "payload_policy": {
        "encrypt": true,
        "max_bytes": 262144,
